# SecureRAG Cloud Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=secure-rag-cloud
APP_HOST=0.0.0.0
APP_PORT=8000

# Azure OpenAI / LLM Provider Configuration
LLM_PROVIDER=mock  # Options: 'mock', 'azure_openai', 'openai'
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01-preview

# Embedding Configuration
EMBEDDING_PROVIDER=tfidf  # Options: 'tfidf', 'azure_openai', 'sentence_transformers'
EMBEDDING_DEPLOYMENT=text-embedding-3-small

# RAG Hyperparameters
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.25

# Security Guardrails
SECURITY_ENABLED=true
MAX_QUERY_LENGTH=1000
BLOCK_INDIRECT_INJECTIONS=true
OUTPUT_GUARD_ENABLED=true

# Azure Monitor & Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=secure-rag-cloud
